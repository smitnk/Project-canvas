#pragma once
#include <mutex>

class QMutex {
public:
  enum RecursionMode { NonRecursive, Recursive };
  explicit QMutex(RecursionMode = NonRecursive) {}
  void lock() { m_mutex.lock(); }
  void unlock() { m_mutex.unlock(); }
  bool tryLock() { return m_mutex.try_lock(); }
private:
  std::recursive_mutex m_mutex;
};
