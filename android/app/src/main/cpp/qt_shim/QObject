#pragma once
#include <cstdarg>
#include <cstdio>
#include "QString"

class QObject {
public:
  virtual ~QObject() = default;
  static QString tr(const char *text) { return QString(text); }
};

inline void qWarning(const char *format, ...) {
  va_list args;
  va_start(args, format);
  std::vfprintf(stderr, format, args);
  std::fputc('\n', stderr);
  va_end(args);
}
