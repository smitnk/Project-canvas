#pragma once
#include <cstdarg>
#include <cstdio>
#include "QString"

class QObject {
public:
  explicit QObject(QObject* parent = nullptr) { (void)parent; }
  virtual ~QObject() = default;
  static QString tr(const char *text) { return QString(text); }
};

#ifndef Q_OBJECT
#define Q_OBJECT
#endif

#ifndef Q_SIGNALS
#define Q_SIGNALS public
#endif

#ifndef Q_SLOTS
#define Q_SLOTS
#endif

inline void qWarning(const char *format, ...) {
  va_list args;
  va_start(args, format);
  std::vfprintf(stderr, format, args);
  std::fputc('\n', stderr);
  va_end(args);
}
