#pragma once

#include <iostream>
#include <cstdio>
#include <utility>

class QDebug {
public:
  QDebug() = default;
  QDebug(const QDebug &) = delete;
  QDebug &operator=(const QDebug &) = delete;

  QDebug(QDebug &&) = default;
  QDebug &operator=(QDebug &&) = default;

  ~QDebug() {
    std::cerr << std::endl;
  }

  template <typename T>
  QDebug &operator<<(const T &value) {
    std::cerr << value;
    return *this;
  }
};

inline QDebug qDebug() {
  return QDebug();
}

template <typename... Args>
inline QDebug qDebug(const char *format, Args... args) {
  std::fprintf(stderr, format, args...);
  return QDebug();
}
