namespace Qt {
enum SplitBehavior { KeepEmptyParts, SkipEmptyParts };
enum Key {
  Key_0 = '0', Key_1 = '1', Key_2 = '2', Key_3 = '3', Key_4 = '4',
  Key_5 = '5', Key_6 = '6', Key_7 = '7', Key_8 = '8', Key_9 = '9'
};
}

class QStringList;

class QString : public std::string {
public:
  using std::string::string;
  QString() = default;
  QString(const std::string& s) : std::string(s) {}
  QString(const char* s) : std::string(s ? s : "") {}
  QString(size_t n, QChar c) : std::string(n, (char)c) {}
  explicit QString(QChar c) : std::string(1, (char)c) {}

  int toInt(bool *ok = nullptr) const {
    char *end = nullptr;
    long v = std::strtol(c_str(), &end, 10);
    if (ok) *ok = (end != c_str());
    return (int)v;
  }

  unsigned int toUInt(bool *ok = nullptr) const {
    char *end = nullptr;
    unsigned long v = std::strtoul(c_str(), &end, 10);
    if (ok) *ok = (end != c_str());
    return (unsigned int)v;
  }

  double toDouble(bool *ok = nullptr) const {
    char *end = nullptr;
    double v = std::strtod(c_str(), &end);
    if (ok) *ok = (end != c_str());
    return v;
  }

  static QString number(int value) { return QString(std::to_string(value)); }
  static QString number(unsigned int value) { return QString(std::to_string(value)); }
  static QString number(long value) { return QString(std::to_string(value)); }
  static QString number(double value) { return QString(std::to_string(value)); }

  static int localeAwareCompare(const QString& a, const QString& b) {
    return a.compare(b);
  }

  QString toLower() const {
    QString result(*this);
    std::transform(result.begin(), result.end(), result.begin(),
                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
    return result;
  }

  QString arg(int value) const { return replaceNextPlaceholder(QString::number(value)); }
  QString arg(unsigned int value) const { return replaceNextPlaceholder(QString::number(value)); }
  QString arg(const QString& value) const { return replaceNextPlaceholder(value); }

  std::string toStdString() const { return *this; }
  static QString fromStdString(const std::string& s) { return QString(s); }
  static QString fromUtf8(const char* s) { return QString(s); }

  static QString fromStdWString(const std::wstring& ws) {
    try {
      std::wstring_convert<std::codecvt_utf8<wchar_t>> converter;
      return QString(converter.to_bytes(ws));
    } catch (...) {
      QString result;
      for (wchar_t c : ws)
        result.push_back(static_cast<char>(c < 128 ? c : '?'));
      return result;
    }
  }

  std::string toUtf8() const { return *this; }
  std::string toLatin1() const { return *this; }

  std::wstring toStdWString() const {
    try {
      std::wstring_convert<std::codecvt_utf8<wchar_t>> converter;
      return converter.from_bytes(*this);
    } catch (...) {
      return std::wstring(begin(), end());
    }
  }

  bool isNull() const { return empty(); }
  bool isEmpty() const { return empty(); }

  QStringList split(char separator, Qt::SplitBehavior behavior) const;

private:
  QString replaceNextPlaceholder(const QString& replacement) const {
    QString result(*this);
    for (int i = 1; i <= 9; ++i) {
      std::string token = "%" + std::to_string(i);
      auto pos = result.find(token);
      if (pos != std::string::npos) {
        result.replace(pos, token.size(), replacement);
        return result;
      }
    }
    return result;
  }
};

inline QString operator+(const QString& a, const QString& b) {
  return QString(static_cast<const std::string&>(a) +
                 static_cast<const std::string&>(b));
}
inline QString operator+(const char* a, const QString& b) {
  return QString(a ? a : "") + b;
}
inline QString operator+(const QString& a, const char* b) {
  return a + QString(b);
}

class QStringList : public std::vector<QString> {
public:
  using std::vector<QString>::vector;
  bool isEmpty() const { return empty(); }
  int count() const { return static_cast<int>(size()); }
  bool contains(const QString& value) const {
    return std::find(begin(), end(), value) != end();
  }
  QString join(const QString& separator) const {
    QString result;
    for (size_t i = 0; i < size(); ++i) {
      if (i) result += separator;
      result += (*this)[i];
    }
    return result;
  }
};

inline QStringList QString::split(char separator, Qt::SplitBehavior behavior) const {
  QStringList result;
  std::string current;
  for (char c : *this) {
    if (c == separator) {
      if (behavior == Qt::KeepEmptyParts || !current.empty())
        result.emplace_back(current);
      current.clear();
    } else {
      current.push_back(c);
    }
  }
  if (behavior == Qt::KeepEmptyParts || !current.empty())
    result.emplace_back(current);
  return result;
}
